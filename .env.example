# Runtime
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
DATABASE_URL=mysql://user:password@localhost:3306/ai_interview

# Authentication (production: generate a random value with at least 32 characters)
JWT_SECRET=replace-with-at-least-32-random-characters
VITE_APP_ID=
OAUTH_SERVER_URL=
OAUTH_PORTAL_URL=
OWNER_OPEN_ID=

# AI APIs (server only; never prefix secrets with VITE_)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
# Quality-first, self-hosted Korean TTS (server-only secrets)
QWEN3_TTS_URL=
QWEN3_TTS_TOKEN=
QWEN3_TTS_ALLOW_INSECURE_HTTP=false

# Lightweight self-hosted fallback
SUPERTONIC3_TTS_URL=
SUPERTONIC3_TTS_TOKEN=
SUPERTONIC_TTS_ALLOW_INSECURE_HTTP=false

# Legacy migration endpoint
SUPERTONIC2_TTS_URL=

# Toss Payments
VITE_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Scheduler (at least 32 random characters)
SCHEDULER_SECRET=

# Business identity shown on receipts (configure in the deployment secret store)
BUSINESS_NAME=
BUSINESS_REPRESENTATIVE=
BUSINESS_REGISTRATION_NUMBER=
BUSINESS_ADDRESS=
BUSINESS_PHONE=
BUSINESS_EMAIL=

# Public business identity embedded in the client bundle (not secrets)
VITE_BUSINESS_NAME=
VITE_BUSINESS_REPRESENTATIVE=
VITE_BUSINESS_REGISTRATION_NUMBER=
VITE_BUSINESS_SALES_NUMBER=
VITE_JOB_INFO_NUMBER=
VITE_BUSINESS_ADDRESS=
VITE_BUSINESS_PHONE=
VITE_BUSINESS_EMAIL=
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_HOURS=평일 11~18시

# Optional Kiwoompay legacy integration
KIWOOMPAY_MODE=test
KIWOOMPAY_AUTH_KEY=
KIWOOMPAY_MERCHANT_ID=
KIWOOMPAY_WEBHOOK_KEY=

# Optional Stripe legacy settings
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
